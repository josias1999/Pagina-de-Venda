<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Escova Alisadora 5 em 1 – Cabelo de Salão em Casa</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --rose: #c2185b;
    --rose-light: #f06292;
    --rose-dark: #880e4f;
    --gold: #f5c842;
    --cream: #fff8f2;
    --dark: #1a0a10;
    --mid: #3d1a2a;
    --text: #2d1018;
    --muted: #7a4a58;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    background: linear-gradient(135deg, var(--dark) 0%, var(--rose-dark) 50%, #4a0028 100%);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 60px 80px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(194,24,91,.35) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    border: 1px solid rgba(245,200,66,.15);
    top: -150px; right: -100px;
    animation: spin 30s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .hero-text { position: relative; z-index: 2; }

  .badge {
    display: inline-block;
    background: var(--gold);
    color: var(--dark);
    font-weight: 700;
    font-size: .72rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 24px;
    animation: fadeDown .6s ease both;
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    color: #fff;
    line-height: 1.1;
    margin-bottom: 20px;
    animation: fadeDown .7s .1s ease both;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--rose-light);
  }

  .hero-sub {
    color: rgba(255,255,255,.72);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 460px;
    margin-bottom: 36px;
    animation: fadeDown .8s .2s ease both;
  }

  .hero-cta {
    display: inline-block;
    background: linear-gradient(135deg, var(--gold), #e8a800);
    color: var(--dark);
    font-weight: 700;
    font-size: 1.1rem;
    padding: 18px 44px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 8px 30px rgba(245,200,66,.45);
    transition: transform .2s, box-shadow .2s;
    animation: fadeDown .9s .3s ease both;
    position: relative;
  }

  .hero-cta::after {
    content: ' →';
  }

  .hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(245,200,66,.6);
  }

  .hero-image-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    animation: fadeUp .9s .2s ease both;
  }

  .hero-image-wrap img {
    width: 100%;
    max-width: 420px;
    border-radius: 24px;
    box-shadow: 0 30px 80px rgba(0,0,0,.5);
    filter: brightness(1.05) saturate(1.1);
  }

  .floating-badge {
    position: absolute;
    background: #fff;
    border-radius: 16px;
    padding: 12px 18px;
    box-shadow: 0 8px 24px rgba(0,0,0,.25);
    font-size: .85rem;
    font-weight: 600;
    color: var(--rose-dark);
    white-space: nowrap;
  }

  .fb-top { top: 30px; right: -20px; animation: float 3s ease-in-out infinite; }
  .fb-bot { bottom: 40px; left: -20px; animation: float 3s .5s ease-in-out infinite; }

  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }

  /* ── URGENCY BAR ── */
  .urgency-bar {
    background: var(--rose);
    color: #fff;
    text-align: center;
    padding: 14px 20px;
    font-weight: 600;
    font-size: .95rem;
    letter-spacing: .03em;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.85} }

  /* ── PAIN SECTION ── */
  .pain {
    background: var(--dark);
    color: #fff;
    padding: 80px 40px;
    text-align: center;
  }

  .pain h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    margin-bottom: 16px;
  }

  .pain p { color: rgba(255,255,255,.65); font-size: 1.05rem; max-width: 600px; margin: 0 auto 48px; }

  .pain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .pain-card {
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 16px;
    padding: 28px 24px;
    transition: background .3s;
  }

  .pain-card:hover { background: rgba(194,24,91,.15); }

  .pain-card .icon { font-size: 2rem; margin-bottom: 12px; }
  .pain-card h3 { font-size: 1rem; margin-bottom: 8px; }
  .pain-card p { font-size: .88rem; color: rgba(255,255,255,.55); margin: 0; }

  /* ── SOLUTION SECTION ── */
  .solution {
    padding: 100px 40px;
    text-align: center;
    background: var(--cream);
  }

  .section-label {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--rose);
    margin-bottom: 14px;
  }

  .solution h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin-bottom: 18px;
  }

  .solution > p {
    max-width: 580px;
    margin: 0 auto 60px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .feature-card {
    background: #fff;
    border-radius: 20px;
    padding: 36px 28px;
    text-align: left;
    box-shadow: 0 4px 24px rgba(0,0,0,.07);
    border: 1px solid rgba(194,24,91,.1);
    transition: transform .25s, box-shadow .25s;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(194,24,91,.14);
  }

  .feature-icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, var(--rose), var(--rose-light));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 20px;
  }

  .feature-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 10px; }
  .feature-card p { font-size: .9rem; color: var(--muted); line-height: 1.65; }

  /* ── GALLERY ── */
  .gallery {
    background: linear-gradient(180deg, var(--cream) 0%, #fde8f0 100%);
    padding: 80px 40px;
    text-align: center;
  }

  .gallery h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin-bottom: 10px;
  }

  .gallery > p { color: var(--muted); margin-bottom: 48px; }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 8px 28px rgba(0,0,0,.12);
    transition: transform .3s;
  }

  .gallery-grid img:hover { transform: scale(1.03); }

  /* ── VIDEO ── */
  .video-section {
    background: var(--dark);
    padding: 100px 40px;
    text-align: center;
    color: #fff;
  }

  .video-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin-bottom: 12px;
  }

  .video-section p { color: rgba(255,255,255,.6); margin-bottom: 48px; font-size: 1rem; }

  .video-wrap {
    max-width: 760px;
    margin: 0 auto;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,.5);
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }

  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    border: none;
  }

  /* ── SPECS ── */
  .specs {
    background: #fff;
    padding: 90px 40px;
    text-align: center;
  }

  .specs h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin-bottom: 48px;
  }

  .specs-table {
    max-width: 640px;
    margin: 0 auto 48px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,.08);
  }

  .spec-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #f0e0e8;
  }

  .spec-row:last-child { border-bottom: none; }

  .spec-label {
    background: var(--rose-dark);
    color: #fff;
    padding: 16px 24px;
    font-weight: 600;
    font-size: .9rem;
    text-align: left;
  }

  .spec-value {
    background: #fdf5f8;
    padding: 16px 24px;
    font-size: .9rem;
    color: var(--text);
    text-align: left;
  }

  /* ── TESTIMONIALS ── */
  .testimonials {
    background: linear-gradient(135deg, var(--rose-dark), var(--dark));
    padding: 90px 40px;
    text-align: center;
    color: #fff;
  }

  .testimonials h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin-bottom: 48px;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .testimonial-card {
    background: rgba(255,255,255,.09);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 20px;
    padding: 32px 28px;
    text-align: left;
  }

  .stars { color: var(--gold); font-size: 1rem; letter-spacing: .1em; margin-bottom: 14px; }
  .testimonial-card p { color: rgba(255,255,255,.8); font-size: .93rem; line-height: 1.65; margin-bottom: 20px; }
  .reviewer { display: flex; align-items: center; gap: 12px; }
  .reviewer-avatar {
    width: 42px; height: 42px;
    background: var(--rose-light);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem; color: #fff;
  }
  .reviewer-name { font-weight: 600; font-size: .9rem; }
  .reviewer-city { font-size: .78rem; color: rgba(255,255,255,.5); }

  /* ── GUARANTEE ── */
  .guarantee {
    background: var(--cream);
    padding: 80px 40px;
    text-align: center;
  }

  .guarantee-inner {
    max-width: 700px;
    margin: 0 auto;
    background: #fff;
    border-radius: 24px;
    padding: 56px 48px;
    box-shadow: 0 8px 40px rgba(194,24,91,.1);
    border: 2px solid rgba(194,24,91,.15);
  }

  .guarantee-icon { font-size: 3.5rem; margin-bottom: 20px; }

  .guarantee h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    margin-bottom: 16px;
    color: var(--rose-dark);
  }

  .guarantee p { color: var(--muted); line-height: 1.7; font-size: 1rem; }

  /* ── CTA FINAL ── */
  .cta-final {
    background: linear-gradient(135deg, var(--rose-dark) 0%, #c2185b 50%, var(--rose-dark) 100%);
    padding: 100px 40px;
    text-align: center;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .cta-final::before {
    content: '';
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.1);
    top: -200px; left: -100px;
    pointer-events: none;
  }

  .cta-final h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.4rem);
    margin-bottom: 16px;
    position: relative;
  }

  .cta-final p { color: rgba(255,255,255,.75); font-size: 1.1rem; margin-bottom: 48px; position: relative; }

  .price-box {
    display: inline-block;
    margin-bottom: 36px;
    position: relative;
  }

  .price-old {
    font-size: 1.1rem;
    color: rgba(255,255,255,.5);
    text-decoration: line-through;
    margin-bottom: 4px;
  }

  .price-new {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--gold);
    line-height: 1;
  }

  .price-installment {
    font-size: .95rem;
    color: rgba(255,255,255,.7);
    margin-top: 6px;
  }

  .cta-btn {
    display: inline-block;
    background: var(--gold);
    color: var(--dark);
    font-weight: 800;
    font-size: 1.25rem;
    padding: 22px 64px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 40px rgba(0,0,0,.3);
    transition: transform .2s, box-shadow .2s;
    position: relative;
    letter-spacing: .02em;
  }

  .cta-btn:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 60px rgba(0,0,0,.4);
  }

  .cta-small {
    margin-top: 24px;
    font-size: .85rem;
    color: rgba(255,255,255,.55);
    position: relative;
  }

  /* ── FOOTER ── */
  footer {
    background: var(--dark);
    color: rgba(255,255,255,.4);
    text-align: center;
    padding: 30px 20px;
    font-size: .82rem;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; padding: 60px 24px 40px; gap: 40px; }
    .hero-image-wrap { order: -1; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .specs-table { font-size: .82rem; }
    .guarantee-inner { padding: 36px 24px; }
    .cta-btn { font-size: 1.05rem; padding: 18px 40px; }
    .fb-top, .fb-bot { display: none; }
  }
</style>
</head>
